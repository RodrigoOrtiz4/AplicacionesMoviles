<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/fondo_aplicativo"
    tools:context=".AcercaDe">

    <TextView
        android:id="@+id/textView3"
        android:layout_width="347dp"
        android:layout_height="50dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center_horizontal"
        android:text="@string/acerca_de"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="38sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView27"
        android:layout_width="402dp"
        android:layout_height="208dp"
        android:layout_marginTop="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.444"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3"
        app:srcCompat="@drawable/logo_escuela" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="267dp"
        android:layout_height="146dp"
        android:layout_marginTop="32dp"
        android:text="@string/integrantes_del_equipo_1_enciso_p_rez_emiliano_2_hern_ndez_apolonio_fernanda_valeria_3_pacheco_jim_nez_alexa_fernanda_4_perrusquia_cid_frida_susana_5_soto_bardales_monserrat"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView27"
        app:layout_constraintVertical_bias="0.159"
        android:textColor="@color/white"
        android:fontFamily="sans-serif-black"
        tools:ignore="MissingConstraints" />
</androidx.constraintlayout.widget.ConstraintLayout>