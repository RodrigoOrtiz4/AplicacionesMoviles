<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imvImage"
        android:layout_width="250dp"
        android:layout_height="300dp"
        android:layout_marginTop="36dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@android:drawable/alert_dark_frame" />

    <Button
        android:id="@+id/btn_p"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="P"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_o"
        tools:layout_editor_absoluteY="523dp" />

    <Button
        android:id="@+id/btn_o"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="O"
        app:layout_constraintEnd_toEndOf="@+id/btn_p"
        app:layout_constraintStart_toEndOf="@+id/btn_i"
        tools:layout_editor_absoluteY="523dp" />

    <Button
        android:id="@+id/btn_i"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="I"
        app:layout_constraintStart_toEndOf="@+id/btn_u"
        tools:layout_editor_absoluteY="523dp" />

    <Button
        android:id="@+id/btn_u"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="U"
        app:layout_constraintStart_toEndOf="@+id/btn_y"
        tools:layout_editor_absoluteY="523dp" />

    <Button
        android:id="@+id/btn_y"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="Y"
        app:layout_constraintStart_toEndOf="@+id/btn_t"
        tools:layout_editor_absoluteY="523dp" />

    <Button
        android:id="@+id/btn_t"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="T"
        app:layout_constraintStart_toEndOf="@+id/btn_r"
        tools:layout_editor_absoluteY="523dp" />

    <Button
        android:id="@+id/btn_r"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="R"
        app:layout_constraintStart_toEndOf="@+id/btn_e"
        tools:layout_editor_absoluteY="523dp" />

    <Button
        android:id="@+id/btn_e"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="E"
        app:layout_constraintStart_toEndOf="@+id/btn_w"
        tools:layout_editor_absoluteY="523dp" />

    <Button
        android:id="@+id/btn_w"
        android:layout_width="43dp"
        android:layout_height="40dp"
        android:text="W"
        app:layout_constraintStart_toEndOf="@+id/btn_q"
        tools:layout_editor_absoluteY="523dp" />

    <Button
        android:id="@+id/btn_q"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="Q"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="523dp" />

</androidx.constraintlayout.widget.ConstraintLayout>